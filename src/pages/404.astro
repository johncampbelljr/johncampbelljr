---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="Page not found" noindex>
  <header class="page-header">
    <div class="eyebrow">404 / PAGE NOT FOUND</div>
    <h1>
      A loose end<span class="accent">.</span>
    </h1>
    <p>This page doesn't exist, or may have moved.</p>
  </header>
  <div class="page-content text-links">
    <a href={url()}>Back home →</a>
    <a href={url('writing/')}>Browse field notes →</a>
  </div>
</Base>
