---
import Base from '../../layouts/Base.astro';
import ContactVaultFlow from '../../components/ContactVaultFlow.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/site';
const projects = await getCollection('projects', ({ data }) => !data.draft);
---

<Base
  title="Projects"
  description="Apps, engineering projects, and experiments."
>
  <header class="page-header">
    <div class="eyebrow">02 / PROJECTS</div>
    <h1>
      Live projects<span class="accent">.</span>
    </h1>
    <p>
      Apps I've built and put into the world, with notes on how they work and
      how I developed them.
    </p>
  </header>
  <div class="page-content">
    {projects.map(({ data }) => (
      <section class="home-section">
        <div class="featured-project">
          <div>
            <div class="project-meta mono">
              PROJECT {data.number}
              <span class="status">
                <span class="signal-dot" />
                {data.status}
              </span>
            </div>
            <h2 style="margin-top:18px">
              <a href={url(`projects/${data.slug}/`)}>
                {data.title} <span class="accent">↗</span>
              </a>
            </h2>
            <p>{data.description}</p>
            <a class="small-link" href={url(`projects/${data.slug}/`)}>
              Explore the project →
            </a>
          </div>
          <ContactVaultFlow />
        </div>
      </section>
    ))}
  </div>
</Base>
