---
import { url, formatDate } from '../lib/site';
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'writing'>;
}
const { entry } = Astro.props;
const { data } = entry;
---

<article class="article-row">
  <div class="article-meta mono">
    {data.placeholder ? (
      'IN DEVELOPMENT'
    ) : data.date ? (
      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
    ) : (
      'FIELD NOTE'
    )}
    <span>
      {data.series
        ? `NOTE ${String(data.order ?? 1).padStart(2, '0')}`
        : 'ESSAY'}
    </span>
  </div>
  <div>
    <h3>
      <a href={url(`writing/${data.slug}/`)}>
        {data.title}
        <span class="row-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    </h3>
    <p>{data.description}</p>
    <div class="tags mono">{data.tags.join(' / ')}</div>
  </div>
</article>
