---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { site, url } from '../lib/site';
interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  date?: Date;
  tags?: string[];
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  article = false,
  date,
  tags = [],
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — Software, systems & the work ahead`;
const nav = [
  ['Home', ''],
  ['Writing', 'writing/'],
  ['Projects', 'projects/'],
  ['Experience', 'experience/'],
  ['About', 'about/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="John T. Campbell Jr. — Field Notes"
      href={url('rss.xml')}
    />
    <meta name="theme-color" content="#f5f3ed" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta
      property="og:image"
      content={new URL(url('og-image.png'), Astro.site)}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="John T. Campbell Jr. — Software, systems & the work ahead"
    />
    <meta name="twitter:card" content="summary_large_image" />
    {article && <meta property="article:author" content={site.name} />}
    {date && (
      <meta property="article:published_time" content={date.toISOString()} />
    )}
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={url()} aria-label="John Campbell Jr home">
          <span class="monogram" aria-hidden="true">
            JCJ<span>∙</span>
          </span>
          <span>JOHN CAMPBELL JR</span>
        </a>
        <nav aria-label="Main navigation">
          {nav.map(([label, path]) => (
            <a
              href={url(path)}
              aria-current={
                (
                  path
                    ? Astro.url.pathname.startsWith(url(path))
                    : Astro.url.pathname === url()
                )
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))}
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div>
          <a class="footer-name" href={url()}>
            JOHN T. CAMPBELL JR.
          </a>
          <span class="footer-location">ASHEVILLE, NC</span>
        </div>
        <div class="footer-links">
          <a href={site.github}>GitHub ↗</a>
          {site.linkedin && <a href={site.linkedin}>LinkedIn ↗</a>}
          <a href={url('rss.xml')}>RSS ↗</a>
          <span class="build">BUILD 2026.001</span>
        </div>
      </footer>
    </div>
  </body>
</html>
